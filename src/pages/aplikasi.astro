---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Phone from "../components/Phone.astro";
import StoreBadges from "../components/StoreBadges.astro";
import Faq from "../components/Faq.astro";
import DownloadBlock from "../components/DownloadBlock.astro";
import { Image } from "astro:assets";
import { photo } from "../data/images";
import { APP_FAQ, MEMBERSHIP, BENEFITS_NOTE } from "../data/content";
import { url } from "../data/site";
import { PLAY_STORE_URL } from "../data/site";

const pains = [
  {
    pain: "Profil yang tidak jelas siapa di baliknya.",
    answer:
      "Setiap akun diverifikasi dengan e-KTP untuk WNI atau paspor untuk WNA, ditambah foto wajah. Paling lama 3×24 jam.",
  },
  {
    pain: "Pengajuan yang digantung berminggu-minggu.",
    answer: "Tidak dibalas dalam 7 hari, pengajuan batal otomatis dan kuotamu kembali.",
    link: { href: "#anti-ghosting", label: "Coba simulasinya" },
  },
  {
    pain: "Berjalan sendirian tanpa pendamping.",
    answer: "Nadzhor selalu didampingi wali atau mahram. Ada konsultasi syariah, kajian, dan ujian pranikah di aplikasi.",
  },
];

const steps = [
  { title: "Daftar", body: "Cukup nama dan email, lalu buat kata sandi. Biodata bisa dilengkapi bertahap." },
  { title: "Lengkapi profil dan verifikasi", body: "Isi biodata, lalu verifikasi identitas dengan e-KTP atau paspor dan foto wajah." },
  { title: "Ajukan ta'aruf", body: "Telusuri calon yang sesuai kriteria, atau minta AI mencarikan, lalu kirim pengajuan." },
  { title: "Berkenalan lewat pesan", body: "Setelah pengajuan diterima, kalian bertukar pesan dengan batas karakter dan jumlah pesan yang jelas." },
  { title: "Proses serius", body: "Kalau sama-sama mantap, akunmu dikunci dari pengajuan lain selama proses berjalan." },
  { title: "Nadzhor", body: "Bertemu dan berbincang lebih dalam, didampingi wali atau mahram." },
  { title: "Khitbah", body: "Komitmen serius bahwa kedua pihak siap membangun rumah tangga." },
  { title: "Walimah", body: "Alhamdulillah, saatnya akad dan walimah. Wedding Organizer Mahabbati siap membantu." },
];

const prep = [
  { src: "kajian", title: "Kajian dan e-learning", body: "Materi rumah tangga dari ustadz, bisa diputar ulang." },
  { src: "ujian_q", title: "Ujian pranikah", body: "Uji kesiapanmu: diri, keluarga, dan ilmu pernikahan." },
  { src: "ujian_hasil", title: "Sertifikat kelulusan", body: "Lulus ujian, unduh sertifikatnya untuk dibagikan." },
  { src: "doa", title: "Doa harian", body: "Doa memohon pasangan, doa untuk orang tua, dan lainnya." },
  { src: "kiblat", title: "Arah kiblat dan jadwal sholat", body: "Ikut lokasimu, dengan pengingat waktu sholat." },
  { src: "acara", title: "Acara dan tabligh akbar", body: "Kajian offline dan acara Mahabbati, tiketnya di aplikasi." },
];

const cell = (v: string | boolean | null) => v;
---

<Base
  title="Aplikasi ta'aruf Mahabbati | Aman, terverifikasi, tidak digantung"
  description="Ta'aruf lewat aplikasi Mahabbati: profil terverifikasi, kuota kembali bila tak dibalas 7 hari, foto muslimah hanya ditinjau admin wanita, nadzhor didampingi wali."
  current="aplikasi"
  ogImage="j-taaruf"
>
  <section class="t-hero wrap" aria-labelledby="t-hero-title">
    <div class="t-hero__copy">
      <h1 id="t-hero-title" class="t-display">Ta'aruf seharusnya menenangkan.</h1>
      <p class="t-lead">
        Profil yang jelas, pengajuan yang tidak digantung, dan pendampingan sampai akad. Semuanya di aplikasi Mahabbati.
      </p>
      <StoreBadges from="taaruf-hero" class="t-hero__stores" />
      <p class="t-hero__note">Daftar gratis, dengan satu pengajuan ta'aruf pertama tanpa biaya.</p>
    </div>
    <div class="t-hero__phones">
      <Phone src="kandidat" alt="Layar detail kandidat dengan skor kompatibilitas 89% dari AI Matchmaker." width={260} class="t-hero__phone t-hero__phone--back" loading="eager" />
      <Phone src="home" alt="Beranda aplikasi Mahabbati: rekomendasi calon, menu Wedding Organizer, kajian, dan ujian pranikah." width={300} class="t-hero__phone t-hero__phone--front" loading="eager" />
    </div>
  </section>

  <section class="pains section" aria-labelledby="pains-title">
    <div class="wrap pains__grid">
      <h2 id="pains-title" class="t-h2 pains__title">Tiga hal yang membuat ta'aruf melelahkan, dan jawaban kami.</h2>
      <ul class="pains__list">
        {
          pains.map((p) => (
            <li class="pain">
              <p class="pain__q">{p.pain}</p>
              <p class="pain__a">
                {p.answer}
                {p.link && (
                  <>
                    {" "}
                    <a class="link" href={p.link.href}>
                      {p.link.label}
                    </a>
                  </>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Satu hal yang hidup: the 7-day quota refund, played by the visitor -->
  <section id="anti-ghosting" class="ghost-sec section chapter-night on-dark" aria-labelledby="ghost-title">
    <div class="wrap ghost-sec__grid">
      <div class="ghost-sec__copy">
        <h2 id="ghost-title" class="t-h2">Tak dibalas 7 hari? Kuotamu kembali.</h2>
        <p class="t-lead">
          Pengajuan yang tidak direspons dalam 7 hari dibatalkan otomatis, dan kuota yang terpakai dikembalikan. Kamu bisa
          lanjut mengajukan ke calon lain tanpa kehilangan apa pun.
        </p>
        <p class="ghost-sec__hint">Kirim pengajuan di simulasi ini, lalu geser waktunya.</p>
      </div>

      <div class="ghost" data-ghost>
        <div class="ghost__quota">
          <span>Sisa kuota pengajuan</span>
          <strong class="num" data-quota>10</strong>
          <svg class="ghost__coin" data-coin viewBox="0 0 40 40" aria-hidden="true">
            <circle cx="20" cy="20" r="17" fill="#D9C38E" />
            <circle cx="20" cy="20" r="12.5" fill="none" stroke="#8A6E3B" stroke-width="2" />
            <path d="M20 13v14M13 20h14" stroke="#33324A" stroke-width="3" stroke-linecap="round" />
          </svg>
        </div>

        <article class="ghost__req" data-req data-state="idle">
          <div class="ghost__avatar" aria-hidden="true">AH</div>
          <div class="ghost__who">
            <p class="ghost__name">AH, 25 tahun</p>
            <p class="ghost__meta">DKI Jakarta, S1, karyawan swasta</p>
          </div>
          <p class="ghost__status" data-status>Belum diajukan</p>
          <span class="ghost__stamp" aria-hidden="true">Otomatis batal</span>
        </article>

        <ol class="ghost__days" aria-hidden="true" data-days>
          {Array.from({ length: 7 }, (_, i) => <li>{i + 1}</li>)}
        </ol>

        <div class="ghost__controls">
          <button class="btn btn--lilac" type="button" data-send>Kirim pengajuan</button>
          <div class="ghost__time">
            <label for="ghost-day">Geser waktu</label>
            <input id="ghost-day" type="range" min="0" max="7" step="1" value="0" disabled data-range aria-valuetext="Hari ke-0" />
            <output for="ghost-day" data-day>Hari ke-0</output>
          </div>
          <div class="ghost__more">
            <button class="btn btn--outline" type="button" data-play disabled>
              <Icon name="play_arrow" size={20} />Putar 7 hari
            </button>
            <button class="btn btn--outline" type="button" data-reset hidden>
              <Icon name="replay" size={20} />Ulangi
            </button>
          </div>
        </div>
        <p class="visually-hidden" role="status" data-live></p>
      </div>
    </div>
  </section>

  <section class="privacy section" aria-labelledby="privacy-title">
    <div class="wrap privacy__grid">
      <div class="privacy__copy">
        <h2 id="privacy-title" class="t-h2">Fotomu tetap milikmu.</h2>
        <ul class="privacy__facts">
          <li>
            <Icon name="verified_user" size={26} />
            <div>
              <h3>Ditinjau admin sesama gender</h3>
              <p>Foto muslimah hanya ditinjau oleh admin wanita.</p>
            </div>
          </li>
          <li>
            <Icon name="hourglass_top" size={26} />
            <div>
              <h3>Terbuka 24 jam setelah kamu setuju</h3>
              <p>Calon baru bisa melihat fotomu kalau kamu menyetujui permintaannya, dan hanya selama 24 jam.</p>
            </div>
          </li>
          <li>
            <Icon name="visibility_off" size={26} />
            <div>
              <h3>Tidak bisa diunduh</h3>
              <p>Foto tampil di dalam aplikasi saja, tanpa tombol simpan.</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="lock" data-photo-demo>
        <figure class="lock__photo">
          <Image
            src={photo("profile-akhwat")}
            alt="Contoh foto profil: muslimah berkerudung biru muda."
            widths={[360, 540, 720]}
            sizes="(max-width: 900px) 80vw, 360px"
            class="lock__img"
            data-photo-img
          />
          <span class="lock__badge" data-photo-badge><Icon name="lock" size={18} />Foto terkunci</span>
        </figure>
        <div class="lock__panel">
          <p class="lock__status" data-photo-status>Ini contoh. Di aplikasi, foto asli tidak pernah tampil tanpa izin.</p>
          <button class="btn" type="button" data-photo-request>Minta lihat foto</button>
          <p class="lock__timer" data-photo-timer-wrap hidden>
            Sisa waktu <span class="num" data-photo-timer>24:00:00</span>
          </p>
        </div>
        <p class="visually-hidden" role="status" data-photo-live></p>
      </div>
    </div>
  </section>

  <section class="verify section chapter-mist" aria-labelledby="verify-title">
    <div class="wrap verify__grid">
      <div class="verify__phones">
        <Phone src="wna/id_capture" alt="Langkah verifikasi: memotret e-KTP atau paspor." width={230} class="verify__phone" />
        <Phone src="wna/id_final" alt="Tinjauan akhir verifikasi identitas." width={230} class="verify__phone verify__phone--b" />
      </div>
      <div class="verify__copy">
        <h2 id="verify-title" class="t-h2">Semua terverifikasi, WNI maupun WNA.</h2>
        <p class="t-lead">
          Setiap pengguna melewati verifikasi yang sama: foto identitas, pemeriksaan wajah, lalu tinjauan akhir oleh admin.
          Prosesnya paling lama 3×24 jam.
        </p>
        <ol class="verify__steps">
          <li><span>e-KTP untuk WNI, paspor untuk WNA</span></li>
          <li><span>Pemeriksaan wajah dengan swafoto</span></li>
          <li><span>Tinjauan akhir oleh admin</span></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="ai section" aria-labelledby="ai-title">
    <div class="wrap ai__grid">
      <div class="ai__copy">
        <h2 id="ai-title" class="t-h2">Ketik kriteriamu, AI kami carikan yang cocok.</h2>
        <p class="t-lead">
          Tulis dengan bahasamu sendiri, misalnya "penyabar dan rajin sholat 5 waktu, domisili Jawa Barat". AI Matchmaker
          mengurutkan calon berdasarkan kecocokan dengan kriteria tersebut.
        </p>
        <p class="ai__note"><Icon name="verified" size={22} />Rekomendasi hanya dari profil yang sudah terverifikasi.</p>
      </div>
      <Phone src="ai" alt="Pencarian kriteria pasangan dengan AI Search: 11 rekomendasi dengan persentase kecocokan." width={300} class="ai__phone" />
    </div>
  </section>

  <section id="panduan" class="guide section chapter-mist" aria-labelledby="guide-title">
    <div class="wrap guide__grid">
      <div class="guide__aside">
        <h2 id="guide-title" class="t-h2">Panduan ta'aruf di Mahabbati.</h2>
        <p class="t-lead">Delapan langkah dari daftar sampai walimah. Setiap langkah punya aturan yang menjaga kedua pihak.</p>
        <div class="guide__rules">
          <h3>Aturan yang perlu kamu tahu</h3>
          <ul>
            <li>Setiap pesan maksimal 1.000 karakter.</li>
            <li>Pengajuan tanpa respons 7 hari batal otomatis, kuota kembali.</li>
            <li>Kuota tidak terbawa saat membership berakhir.</li>
            <li>Pembelian kuota tambahan butuh membership aktif.</li>
          </ul>
        </div>
      </div>
      <ol class="guide__steps">
        {
          steps.map((s, i) => (
            <li class="guide__step" data-reveal style={`--d:${(i % 2) * 70}`}>
              <span class="guide__num num" aria-hidden="true">
                {i + 1}
              </span>
              <div>
                <h3 class="t-h3">{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="pranikah" class="prep section" aria-labelledby="prep-title">
    <div class="wrap prep__head">
      <h2 id="prep-title" class="t-h2">Bekal ilmu sebelum akad.</h2>
      <p class="t-lead">Kajian, ujian pranikah, sampai jadwal sholat. Tersedia untuk member Silver dan Gold.</p>
      <div class="prep__nav">
        <button type="button" class="prep__btn" data-row-prev aria-controls="prep-row">
          <Icon name="chevron_left" size={26} /><span class="visually-hidden">Sebelumnya</span>
        </button>
        <button type="button" class="prep__btn" data-row-next aria-controls="prep-row">
          <Icon name="chevron_right" size={26} /><span class="visually-hidden">Berikutnya</span>
        </button>
      </div>
    </div>
    <div class="prep__row" id="prep-row" data-row data-cursor="Geser" data-lenis-prevent tabindex="0" role="region" aria-label="Fitur persiapan pranikah, geser ke samping">
      <ul>
        {
          prep.map((p) => (
            <li class="prep__card">
              <Phone src={p.src} alt="" width={250} />
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="after section chapter-night on-dark" aria-labelledby="after-title">
    <div class="wrap after__grid">
      <div class="after__copy">
        <h2 id="after-title" class="t-h2">Setelah menikah pun, aplikasinya tetap menemani.</h2>
        <p class="t-lead">Mahabbati tidak berhenti di hari akad. Pasangan yang menikah tetap bisa belajar dan bertanya ke asatidz.</p>
        {BENEFITS_NOTE && <p class="after__note">{BENEFITS_NOTE}</p>}
        <a class="btn btn--lilac" href={url("/asatidz/")}>Kenali asatidz Mahabbati</a>
      </div>
      <ul class="after__list">
        <li><Icon name="menu_book" size={28} /><div><h3>Kajian rumah tangga</h3><p>Akses khusus kajian untuk pengantin baru.</p></div></li>
        <li><Icon name="calendar_month" size={28} /><div><h3>Seminar rumah tangga</h3><p>Undangan seminar bersama asatidz.</p></div></li>
        <li><Icon name="forum" size={28} /><div><h3>Konsultasi syariah</h3><p>Tanya langsung ke asatidz kapan pun dibutuhkan.</p></div></li>
        <li><Icon name="explore" size={28} /><div><h3>Doa harian dan arah kiblat</h3><p>Sudah tersedia untuk semua pengguna.</p></div></li>
      </ul>
    </div>
  </section>

  <section class="to-wo section" aria-labelledby="towo-title">
    <div class="wrap to-wo__inner">
      <h2 id="towo-title" class="t-h2">Sudah bertemu calon?</h2>
      <p class="t-lead">Lanjutkan dengan khitbah, akad, dan walimah bersama Wedding Organizer Mahabbati.</p>
      <a class="btn" href={url("/layanan/")}>Lihat layanan WO</a>
    </div>
  </section>

  <section id="membership" class="members section chapter-mist" aria-labelledby="members-title">
    <div class="wrap">
      <div class="members__head">
        <h2 id="members-title" class="t-h2">Mulai gratis, naik saat kamu siap.</h2>
        <p class="t-lead">Harga dan masa aktif terbaru tersedia di aplikasi.</p>
      </div>
      <div class="members__scroll" data-lenis-prevent tabindex="0" role="region" aria-label="Tabel perbandingan membership">
        <table class="members__table">
          <caption class="visually-hidden">Perbandingan membership Free, Silver, dan Gold</caption>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Fitur</span></th>
              {
                MEMBERSHIP.tiers.map((t) => (
                  <th scope="col" class:list={["members__tier", `members__tier--${t.toLowerCase()}`]}>
                    {t}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              MEMBERSHIP.rows.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  {r.values.map((v) => (
                    <td>
                      {v === true && <Icon name="check" size={22} label="Termasuk" />}
                      {(v === false || v === null) && (
                        <span class="members__no">
                          <span aria-hidden="true">–</span>
                          <span class="visually-hidden">Tidak termasuk</span>
                        </span>
                      )}
                      {typeof v === "string" && <span class="num">{cell(v)}</span>}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <a class="btn members__cta" href={PLAY_STORE_URL} rel="noopener" data-track="play:membership">Lihat harga di aplikasi</a>
    </div>
  </section>

  <section id="faq" class="faq-sec section" aria-labelledby="faq-title">
    <div class="wrap faq-sec__grid">
      <h2 id="faq-title" class="t-h2">Tanya jawab.</h2>
      <Faq items={APP_FAQ} id="faq-taaruf" />
    </div>
  </section>

  <DownloadBlock from="taaruf" />
</Base>

<style>
  /* ---------- Hero ---------- */
  .t-hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-7);
    align-items: center;
    padding-block: clamp(32px, 5vw, 72px) var(--s-8);
  }
  .t-hero__copy .t-lead {
    margin-top: var(--s-5);
  }
  .t-hero__copy :global(.t-hero__stores) {
    margin-top: var(--s-6);
  }
  .t-hero__note {
    margin-top: var(--s-4);
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .t-hero__phones {
    position: relative;
    height: 620px;
  }
  .t-hero__phones :global(.t-hero__phone) {
    position: absolute;
  }
  .t-hero__phones :global(.t-hero__phone--back) {
    left: 0;
    top: 70px;
  }
  .t-hero__phones :global(.t-hero__phone--front) {
    right: 0;
    top: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .js .t-hero__phones :global(.t-hero__phone--front) {
      animation: phone-in 1100ms var(--ease-expo) 150ms both;
    }
    .js .t-hero__phones :global(.t-hero__phone--back) {
      animation: phone-in 1100ms var(--ease-expo) 300ms both;
    }
  }
  @keyframes phone-in {
    from {
      opacity: 0;
      transform: translateY(48px) rotate(2deg);
    }
  }

  /* ---------- Pains ---------- */
  .pains__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-8);
  }
  .pains__title {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    align-self: start;
  }
  .pains__list {
    list-style: none;
  }
  .pain {
    padding-block: var(--s-6);
    border-top: 1px solid var(--line);
  }
  .pain:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .pain__q {
    font-family: var(--serif);
    font-size: var(--t-h3);
    line-height: 1.3;
    color: var(--ink-2);
  }
  .pain__a {
    margin-top: var(--s-3);
    font-size: var(--t-lead);
    color: var(--ink);
    max-width: 44ch;
  }

  /* ---------- Anti-ghosting demo ---------- */
  .ghost-sec__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--s-8);
    align-items: center;
  }
  .ghost-sec__copy .t-lead {
    margin-top: var(--s-5);
  }
  .ghost-sec__hint {
    margin-top: var(--s-5);
    font-family: var(--serif);
    font-style: italic;
    color: #fff;
  }
  .ghost {
    position: relative;
    padding: clamp(20px, 3vw, 36px);
    border-radius: 28px;
    background: var(--ground);
    color: var(--ink);
    --focus: var(--accent-ink);
  }
  .ghost__quota {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-m);
    background: var(--brand);
    color: var(--haze);
  }
  .ghost__quota strong {
    font-family: var(--serif);
    font-size: 2.5rem;
    font-weight: 400;
    color: #fff;
    line-height: 1;
  }
  .ghost__coin {
    position: absolute;
    right: 64px;
    top: 50%;
    width: 36px;
    height: 36px;
    opacity: 0;
    pointer-events: none;
  }
  .ghost__req {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-2) var(--s-4);
    align-items: center;
    margin-top: var(--s-5);
    padding: var(--s-5);
    border-radius: var(--r-m);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: clip;
  }
  .ghost__avatar {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--lilac);
    color: var(--night);
    font-weight: 700;
  }
  .ghost__name {
    font-weight: 600;
  }
  .ghost__meta {
    font-size: var(--t-small);
    color: var(--ink-2);
  }
