---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import VenueCard from "../../components/VenueCard.astro";
import PackageCard from "../../components/PackageCard.astro";
import { Image } from "astro:assets";
import { photo } from "../../data/images";
import { VENUES, venueTypeLabel, VENUE_TYPES, type Venue } from "../../data/venues";
import { PACKAGES } from "../../data/packages";
import { WA, waLink, rupiah, url } from "../../data/site";

export function getStaticPaths() {
  return VENUES.map((v) => ({ params: { slug: v.slug }, props: { venue: v } }));
}
interface Props {
  venue: Venue;
}
const { venue } = Astro.props;
const icon = VENUE_TYPES.find((t) => t.id === venue.type)?.icon ?? "location_city";
const packages = PACKAGES.filter((p) => venue.needs.includes(p.need)).slice(0, 3);
const others = VENUES.filter((v) => v.slug !== venue.slug && (v.type === venue.type || v.city === venue.city)).slice(0, 3);
const wa = waLink(
  WA.wo.number,
  `Assalamu'alaikum, Tim WO Mahabbati. Saya ingin cek ketersediaan ${venue.name}.\nTanggal: [isi tanggal]\nPerkiraan tamu: [isi jumlah]\nBoleh dibantu?`,
);
---

<Base
  title={`${venue.name} | Tempat mitra Mahabbati`}
  description={`${venueTypeLabel(venue.type)} di ${venue.city} untuk akad dan walimah. Mulai ${rupiah(venue.priceFrom)}, ${venue.priceNote}.`}
  current="tempat"
  ogImage={venue.photo}
>
  <nav class="crumbs wrap" aria-label="Breadcrumb">
    <ol>
      <li><a href={url("/tempat/")}>Tempat</a></li>
      <li aria-current="page">{venue.name}</li>
    </ol>
  </nav>

  <section class="vd wrap" aria-labelledby="vd-title">
    <div class="vd__copy">
      <p class="vd__type"><Icon name={icon} size={20} />{venueTypeLabel(venue.type)}, {venue.city}</p>
      <h1 id="vd-title" class="t-h2">{venue.name}</h1>
      {
        venue.placeholder && (
          <p class="sample-note">
            <Icon name="info" size={20} />
            Tempat ini contoh. Nama, kapasitas, dan harga akan diganti dengan data mitra resmi.
          </p>
        )
      }
      <dl class="vd__facts">
        {
          venue.capacity.akad && (
            <div>
              <dt>Kapasitas akad</dt>
              <dd class="num">{venue.capacity.akad} tamu</dd>
            </div>
          )
        }
        {
          venue.capacity.walimah && (
            <div>
              <dt>Kapasitas walimah</dt>
              <dd class="num">{venue.capacity.walimah} tamu</dd>
            </div>
          )
        }
        <div>
          <dt>Mulai</dt>
          <dd class="num">{rupiah(venue.priceFrom)}</dd>
          <dd class="vd__note">{venue.priceNote}</dd>
        </div>
      </dl>
      <h2 class="vd__h">Fasilitas</h2>
      <ul class="vd__facilities">
        {
          venue.facilities.map((f) => (
            <li>
              <Icon name="check" size={20} />
              {f}
            </li>
          ))
        }
      </ul>
      <div class="vd__ctas">
        <a class="btn btn--wa" href={wa} rel="noopener" data-track={`wa:venue-${venue.slug}`}>
          <Icon name="whatsapp" size={20} />Cek ketersediaan tanggal
        </a>
        <a class="btn btn--outline" href="#paket-di-sini">Lihat paket untuk tempat ini</a>
      </div>
    </div>
    <div class="vd__gallery">
      <figure class="vd__main lens" data-lens>
        <Image class="lens__mono" src={photo(venue.gallery[0])} alt={venue.alt} widths={[640, 960, 1280]} sizes="(max-width: 900px) 92vw, 46vw" loading="eager" fetchpriority="high" />
        <Image class="lens__color" src={photo(venue.gallery[0])} alt="" widths={[640, 960, 1280]} sizes="(max-width: 900px) 92vw, 46vw" loading="eager" />
      </figure>
      {
        venue.gallery.slice(1, 3).map((g) => (
          <figure class="vd__side photo" data-reveal="mask">
            <Image src={photo(g)} alt="" widths={[320, 480, 640]} sizes="(max-width: 900px) 44vw, 22vw" />
          </figure>
        ))
      }
    </div>
  </section>

  <section id="paket-di-sini" class="vd-pk section chapter-mist" aria-labelledby="vdpk-title">
    <div class="wrap">
      <h2 id="vdpk-title" class="t-h2">Paket yang bisa dipakai di sini.</h2>
      <ul class="card-grid">
        {
          packages.map((p) => (
            <li>
              <PackageCard pkg={p} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="vd-others section" aria-labelledby="vdo-title">
        <div class="wrap">
          <h2 id="vdo-title" class="t-h2">Tempat lain yang mirip.</h2>
          <ul class="card-grid">
            {others.map((v) => (
              <li>
                <VenueCard venue={v} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  .crumbs {
    padding-top: var(--s-5);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .crumbs li + li::before {
    content: "/";
    margin-right: var(--s-2);
    color: var(--ink-3);
  }
  .crumbs a {
    color: var(--accent-ink);
    text-underline-offset: 0.2em;
  }
  .vd {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--s-8);
    align-items: start;
    padding-block: var(--s-6) var(--s-9);
  }
  .vd__copy {
    display: grid;
    gap: var(--s-4);
  }
  .vd__type {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--accent-ink);
  }
  .vd__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4) var(--s-7);
    padding-block: var(--s-4);
    border-block: 1px solid var(--line);
  }
  .vd__facts dt {
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .vd__facts dd {
    font-family: var(--serif);
    font-size: 1.5rem;
  }
  .vd__facts .vd__note {
    font-family: var(--sans);
    font-size: var(--t-micro);
    color: var(--ink-2);
  }
  .vd__h {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-top: var(--s-2);
  }
  .vd__facilities {
    list-style: none;
    display: grid;
    gap: var(--s-2);
  }
  .vd__facilities li {
    display: flex;
    gap: var(--s-2);
    color: var(--ink-2);
  }
  .vd__facilities :global(.icon) {
    color: var(--success);
    flex: none;
  }
  .vd__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }
  .vd__gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: var(--s-4);
  }
  .vd__main {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 3;
  }
  .vd__side {
    aspect-ratio: 4 / 3;
  }
  .card-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
    margin-top: var(--s-7);
  }
  .card-grid > li {
    display: grid;
  }
  @media (max-width: 1100px) {
    .card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .vd {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }
    .vd__gallery {
      order: -1;
    }
  }
  @media (max-width: 640px) {
    .card-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import "../../scripts/lens.ts";
</script>
