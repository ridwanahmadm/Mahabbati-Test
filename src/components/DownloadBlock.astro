---
// Closing call to action: the app is the only place to search and send ta'aruf requests.
import QRCode from "qrcode";
import StoreBadges from "./StoreBadges.astro";
import Phone from "./Phone.astro";
import { PLAY_STORE_URL } from "../data/site";

interface Props {
  from: string;
  title?: string;
  body?: string;
}
const {
  from,
  title = "Ajukan ta'aruf pertamamu gratis.",
  body = "Pencarian calon, pengajuan ta'aruf, dan chat hanya ada di aplikasi Mahabbati. Daftar gratis, lalu lengkapi biodata pelan-pelan.",
} = Astro.props;
const qr = await QRCode.toString(PLAY_STORE_URL, {
  type: "svg",
  margin: 0,
  errorCorrectionLevel: "M",
  color: { dark: "#222136", light: "#00000000" },
});
---

<section class="download section chapter-mist" aria-labelledby={`dl-${from}`}>
  <div class="wrap download__grid">
    <div class="download__copy">
      <h2 id={`dl-${from}`} class="t-h2">{title}</h2>
      <p class="t-lead">{body}</p>
      <StoreBadges from={from} class="download__stores" />
      <div class="download__qr">
        <div class="download__qr-code" set:html={qr} role="img" aria-label="Kode QR menuju Mahabbati di Google Play" />
        <p>Buka kamera ponselmu, arahkan ke kode ini untuk langsung ke Google Play.</p>
      </div>
    </div>
    <div class="download__phones" aria-hidden="true">
      <Phone src="taarufku" alt="" width={250} class="download__phone download__phone--back" />
      <Phone src="home" alt="" width={290} class="download__phone download__phone--front" />
    </div>
  </div>
</section>

<style>
  .download__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--s-8);
    align-items: center;
  }
  .download__copy .t-lead {
    margin-top: var(--s-4);
  }
  .download__copy :global(.download__stores) {
    margin-top: var(--s-6);
  }
  .download__qr {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin-top: var(--s-6);
    padding: var(--s-4);
    max-width: 30rem;
    border-radius: var(--r-m);
    background: var(--paper);
  }
  .download__qr-code {
    flex: none;
    width: 96px;
    height: 96px;
  }
  .download__qr-code :global(svg) {
    width: 100%;
    height: 100%;
  }
  .download__qr p {
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .download__phones {
    position: relative;
    height: 560px;
  }
  .download__phones :global(.download__phone) {
    position: absolute;
  }
  .download__phones :global(.download__phone--back) {
    left: 4%;
    top: 40px;
    rotate: -6deg;
  }
  .download__phones :global(.download__phone--front) {
    right: 6%;
    top: 0;
    rotate: 3deg;
  }
  @media (max-width: 900px) {
    .download__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .download__qr {
      display: none;
    }
    .download__phones {
      height: 440px;
      max-width: 420px;
    }
    .download__phones :global(.download__phone--back) {
      width: 200px;
    }
    .download__phones :global(.download__phone--front) {
      width: 230px;
    }
  }
</style>
