---
import { url, WA, waLink, WO_GREETING, type NavKey } from "../data/site";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

interface Props {
  current?: NavKey;
}
const { current = "home" } = Astro.props;
const nav: { href: string; label: string; key: NavKey }[] = [
  { href: "/layanan/", label: "Layanan", key: "layanan" },
  { href: "/tempat/", label: "Tempat", key: "tempat" },
  { href: "/asatidz/", label: "Asatidz & kelas", key: "asatidz" },
  { href: "/cerita/", label: "Cerita", key: "cerita" },
  { href: "/aplikasi/", label: "Aplikasi ta'aruf", key: "aplikasi" },
];
const wa = waLink(WA.wo.number, WO_GREETING);
---

<header class="site-header" data-header>
  <div class="wrap site-header__bar">
    <a href={url("/")} class="site-header__home" aria-label="Mahabbati, ke beranda">
      <Logo part="lockup" />
    </a>

    <nav class="site-nav" aria-label="Utama">
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={url(n.href)} aria-current={n.key === current ? "page" : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn site-header__cta" href={wa} rel="noopener" data-track="wa:header">
      <Icon name="whatsapp" size={18} />Konsultasi
    </a>

    <button
      class="site-header__menu"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-toggle
    >
      <Icon name="menu" size={24} class="icon-open" />
      <Icon name="close" size={24} class="icon-close" />
      <span class="visually-hidden">Menu</span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <nav aria-label="Utama, seluler" class="wrap">
      <ul>
        <li><a href={url("/")}>Beranda</a></li>
        {
          nav.map((n) => (
            <li>
              <a href={url(n.href)} aria-current={n.key === current ? "page" : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--wa" href={wa} rel="noopener" data-track="wa:menu"><Icon name="whatsapp" size={20} />Konsultasi via WhatsApp</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ground);
    transition: box-shadow var(--t-ui) ease;
  }
  .site-header:global(.is-scrolled) {
    box-shadow: 0 1px 0 var(--line);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    height: var(--header-h);
  }
  .site-header__home {
    display: inline-flex;
    text-decoration: none;
    padding: 6px 0;
  }
  .site-nav {
    margin-left: auto;
  }
  .site-nav ul {
    display: flex;
    gap: var(--s-2);
    list-style: none;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--s-3);
    border-radius: var(--r-s);
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--t-hover) ease, background-color var(--t-hover) ease;
  }
  .site-nav a:hover {
    color: var(--ink);
    background: var(--mist);
  }
  .site-nav a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }
  .site-header__cta {
    min-height: 44px;
    padding-inline: var(--s-4);
    font-size: var(--t-small);
  }
  .site-header__menu {
    display: none;
    margin-left: auto;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 0;
    border-radius: var(--r-s);
    background: var(--mist);
    color: var(--ink);
  }
  .site-header__menu :global(.icon-close) {
    display: none;
  }
  .site-header__menu[aria-expanded="true"] :global(.icon-open) {
    display: none;
  }
  .site-header__menu[aria-expanded="true"] :global(.icon-close) {
    display: block;
  }
  .mobile-nav {
    border-top: 1px solid var(--line);
    background: var(--ground);
    padding-block: var(--s-4) var(--s-6);
  }
  .mobile-nav ul {
    list-style: none;
    margin-bottom: var(--s-5);
  }
  .mobile-nav li a {
    display: flex;
    align-items: center;
    min-height: 52px;
    font-family: var(--serif);
    font-size: 1.375rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .mobile-nav li a[aria-current="page"] {
    color: var(--accent-ink);
  }
  .mobile-nav .btn {
    width: 100%;
  }
  @media (max-width: 1080px) {
    .site-nav,
    .site-header__cta {
      display: none;
    }
    .site-header__menu {
      display: grid;
    }
  }
  @media (max-width: 720px) {
    .site-header :global(.logo-lockup__mark) {
      width: 40px;
    }
    .site-header :global(.logo-lockup__word) {
      width: 100px;
    }
  }
</style>
