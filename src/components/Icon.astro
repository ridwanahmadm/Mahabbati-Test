---
// Icons inlined at build time as SVG:
// - UI icons: Google Material Symbols, Rounded, weight 400 (Apache 2.0).
// - Brand logos: Font Awesome Free Brands (CC BY 4.0, attribution kept in each SVG).
interface Props {
  name: string;
  size?: number;
  label?: string;
  fill?: boolean;
  class?: string;
}
const { name, size = 24, label, fill = false, class: cls } = Astro.props;

const BRANDS = new Set(["whatsapp", "instagram", "google-play", "apple"]);
const material = import.meta.glob<string>("/node_modules/@material-symbols/svg-400/rounded/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const brands = import.meta.glob<string>("/node_modules/@fortawesome/fontawesome-free/svgs/brands/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const raw = BRANDS.has(name)
  ? brands[`/node_modules/@fortawesome/fontawesome-free/svgs/brands/${name}.svg`]
  : material[`/node_modules/@material-symbols/svg-400/rounded/${name}${fill ? "-fill" : ""}.svg`];
if (!raw) throw new Error(`Icon not found: ${name}`);

const viewBox = raw.match(/viewBox="([^"]+)"/)?.[1] ?? "0 0 24 24";
const inner = raw
  .replace(/^<svg[^>]*>/, "")
  .replace(/<\/svg>\s*$/, "")
  .replace(/fill="currentColor"/g, "");
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  width={size}
  height={size}
  fill="currentColor"
  class:list={["icon", cls]}
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  focusable="false"
  set:html={inner}
/>
